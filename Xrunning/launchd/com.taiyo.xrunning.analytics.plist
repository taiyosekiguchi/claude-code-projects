<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.taiyo.xrunning.analytics</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/taiyo/Documents/書類 - TaiyoのMac mini/gitfiles/claude-code-projects/Xrunning/scripts/run_analytics.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <!-- 07:50 T+24h/48hスナップショット + 投稿前分析 -->
        <dict>
            <key>Hour</key>
            <integer>7</integer>
            <key>Minute</key>
            <integer>50</integer>
        </dict>
        <!-- 09:00 T+1hスナップショット -->
        <dict>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <!-- 14:00 T+6hスナップショット -->
        <dict>
            <key>Hour</key>
            <integer>14</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/taiyo/Documents/書類 - TaiyoのMac mini/gitfiles/claude-code-projects/Xrunning/logs/analytics_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/taiyo/Documents/書類 - TaiyoのMac mini/gitfiles/claude-code-projects/Xrunning/logs/analytics_stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/taiyo/.local/bin</string>
        <key>HOME</key>
        <string>/Users/taiyo</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/taiyo/Documents/書類 - TaiyoのMac mini/gitfiles/claude-code-projects/Xrunning</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
